TARGET_NAME := cubspielecom
STATIC_LINKING ?= 0

GIT_VERSION := $(shell git rev-parse --short HEAD 2>/dev/null)
ifneq ($(GIT_VERSION),)
  CFLAGS += -DGIT_VERSION=\"$(GIT_VERSION)\"
endif

ifeq ($(platform),)
  platform = unix
  ifeq ($(shell uname -a),)
    platform = win
  else ifneq ($(findstring MINGW,$(shell uname -a)),)
    platform = win
  else ifneq ($(findstring Darwin,$(shell uname -a)),)
    platform = osx
  else ifneq ($(findstring win,$(shell uname -a)),)
    platform = win
  endif
endif

ifeq ($(origin CC), default)
  CC := gcc
endif

AR ?= ar

SOURCES_C := \
	src/sm8521.c \
	src/lcd.c \
	src/audio.c \
	src/zip_bios.c \
	src/libretro.c

OBJECTS := $(SOURCES_C:.c=.o)

CFLAGS += -std=c99 -Wall -Wextra -Wno-unused-parameter -Iinclude -Isrc

ifeq ($(DEBUG), 1)
  CFLAGS += -O0 -g
else
  CFLAGS += -O3 -DNDEBUG
endif

ifeq ($(platform), unix)
  TARGET := $(TARGET_NAME)_libretro.so
  fpic := -fPIC
  SHARED := -shared -Wl,--version-script=link.T -Wl,--no-undefined
  LDFLAGS += -lm
else ifeq ($(platform), osx)
  TARGET := $(TARGET_NAME)_libretro.dylib
  fpic := -fPIC
  SHARED := -dynamiclib
  LDFLAGS += -lm
else ifeq ($(platform), ios-arm64)
  TARGET := $(TARGET_NAME)_libretro_ios.dylib
  fpic := -fPIC
  SHARED := -dynamiclib
  CC := clang -arch arm64 -isysroot $(shell xcrun --sdk iphoneos --show-sdk-path)
  LDFLAGS += -lm
else ifeq ($(platform), win)
  TARGET := $(TARGET_NAME)_libretro.dll
  SHARED := -shared -static-libgcc -Wl,--no-undefined
  LDFLAGS += -lm
else ifeq ($(platform), android)
  TARGET := $(TARGET_NAME)_libretro_android.so
  fpic := -fPIC
  SHARED := -shared -Wl,--version-script=link.T -Wl,--no-undefined
  LDFLAGS += -lm -llog
else ifeq ($(platform), emscripten)
  TARGET := $(TARGET_NAME)_libretro_emscripten.bc
  fpic := -fPIC
  STATIC_LINKING = 1
else ifeq ($(platform), libnx)
  TARGET := $(TARGET_NAME)_libretro_libnx.a
  CC := $(DEVKITPRO)/devkitA64/bin/aarch64-none-elf-gcc
  AR := $(DEVKITPRO)/devkitA64/bin/aarch64-none-elf-ar
  CFLAGS += -march=armv8-a -mtune=cortex-a57 -mtp=soft -fPIE
  STATIC_LINKING = 1
else ifeq ($(platform), vita)
  TARGET := $(TARGET_NAME)_libretro_vita.a
  CC := arm-vita-eabi-gcc
  AR := arm-vita-eabi-ar
  STATIC_LINKING = 1
else ifeq ($(platform), ctr)
  TARGET := $(TARGET_NAME)_libretro_ctr.a
  CC := $(DEVKITARM)/bin/arm-none-eabi-gcc
  AR := $(DEVKITARM)/bin/arm-none-eabi-ar
  CFLAGS += -march=armv6k -mtune=mpcore -mfloat-abi=hard
  STATIC_LINKING = 1
endif

ifeq ($(STATIC_LINKING), 1)
  ifeq ($(TARGET),)
    TARGET := $(TARGET_NAME)_libretro_$(platform).a
  endif
  CFLAGS += -DSTATIC_LINKING
endif

CFLAGS += $(fpic)

all: $(TARGET)

$(TARGET): $(OBJECTS)
ifeq ($(STATIC_LINKING), 1)
	$(AR) rcs $@ $(OBJECTS)
else
	$(CC) $(fpic) $(SHARED) -o $@ $(OBJECTS) $(LDFLAGS)
endif

%.o: %.c
	$(CC) $(CFLAGS) -c -o $@ $<

clean:
	rm -f $(OBJECTS) $(TARGET)

.PHONY: all clean
